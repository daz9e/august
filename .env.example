# Normally not needed: `cargo run -- login` saves provider, model and keys to ~/.august.
# Anything set here overrides those saved settings.

# AUGUST_PROVIDER=opencode-go   # opencode-go | opencode | anthropic | chatgpt | openai
# AUGUST_MODEL=glm-5.3
# AUGUST_EFFORT=medium          # reasoning effort: low | medium | high | ...

# ANTHROPIC_API_KEY=
# OPENCODE_API_KEY=             # OpenCode Zen and Go
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenCode only: force the wire format instead of looking it up on models.dev
# AUGUST_API_FORMAT=chat        # chat | responses | messages

# Directory the agent works in (shell cwd, file tools root)
AUGUST_WORKSPACE=./workspace
